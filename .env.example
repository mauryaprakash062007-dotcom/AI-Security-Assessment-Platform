# Copy this to .env for local (non-Docker) runs.
# docker-compose.yml already sets these itself for the containers,
# so you normally don't need this file when running via `docker compose up`.

DATABASE_URL=postgresql://postgres:mypassword123@localhost/security_platform
REDIS_URL=redis://localhost:6379/0

# Only needed if nuclei isn't on your PATH / templates aren't in the default location
NUCLEI_BIN=nuclei
NUCLEI_TEMPLATES_DIR=~/nuclei-templates

# AI & Platform API Keys (Required for AI Threat Modeler and Remediation)
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
PLATFORM_API_KEY=your_platform_api_key_here

# Network Configuration
ALLOW_PRIVATE_IPS=true
